{
    "name": "umut/chat-app",
    "version": "1.0.0",
    "description": "A Clean Architecture Chat Application Backend using PHP, Slim Framework, and SQLite.",
    "autoload": {
        "psr-4": {
            "ChatApp\\Application\\": "src/Application/",
            "ChatApp\\Domain\\": "src/Domain/",
            "ChatApp\\Infrastructure\\": "src/Infrastructure/",
            "ChatApp\\Middleware\\": "src/Middleware/",
            "ChatApp\\Presentation\\": "src/Presentation/"
        }
    },

    "authors": [
        {
            "name": "OkcuYazilimci",
            "email": "umutuygun.u@gmail.com"
        }
    ],
    "require": {
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "illuminate/database": "^11.41",
        "php-di/php-di": "^7.0",
        "zircote/swagger-php": "^5.0",
        "firebase/php-jwt": "^6.11",
        "vlucas/phpdotenv": "^5.6",
        "nesbot/carbon": "^3.8",
        "ramsey/uuid": "^4.7",
        "illuminate/pagination": "^11.41"
    },
    "config": {
        "platform": {
            "php": "8.4.3"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    }
}
